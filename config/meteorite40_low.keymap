#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 200
#include <dt-bindings/zmk/pointing.h>

#include <behaviors/custom_config.dtsi>
#include <behaviors/meteorite_custom_key.dtsi>
#include <behaviors/meteorite_bt_os.dtsi>
#include <behaviors/meteorite_mod_key.dtsi>
#include <behaviors/meteorite_os_key.dtsi>
#include <behaviors/studio_bt_disc.dtsi>
#include <dt-bindings/zmk/custom_config.h>
#include <dt-bindings/zmk/meteorite_custom_keys.h>
#include <dt-bindings/zmk/meteorite_bt_os.h>

&mt { 
    flavor = "tap-preferred"; // change hold to tap
    tapping-term-ms = <200>;
    meteorite-tapping-term-source = "mod-tap";
    quick-tap-ms = <150>; // change 200 to 150
    require-prior-idle-ms = <(-1)>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>; // change 200 to 150
    meteorite-tapping-term-source = "layer-tap";
    quick-tap-ms = <150>; // change 200 to 150
    require-prior-idle-ms = <(-1)>;
};

/ {
    behaviors {
        mck_mt: mck_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            meteorite-tapping-term-source = "mod-tap";
            bindings = <&mck>, <&kp>;
            display-name = "meteorite OS-Switch-mod-tap";
        };

        mck_mt_st: mck_mt_st {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            meteorite-tapping-term-source = "mod-tap";
            bindings = <&mck>, <&alt_cmd_tab>;
            display-name = "meteorite OS-Switch-mod-tap (smart toggle)";
        };

        alt_cmd_tab: alt_cmd_tab {
            compatible = "zmk,behavior-smart-toggle";
            #binding-cells = <0>;
            display-name = "meteorite Smart toggle (Alt/Cmd+Tab)";
            bindings = <&mck M_OS_ALT_CMD>, <&kp TAB>;
            position-bindings = <12 13>; /* D, F */
            position-binding-behaviors = <&kp LS(TAB)>, <&kp TAB>;
        };

        enc_msc: encoder_mouse_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <25>;
            display-name = "Encoder Mouse Scroll";
        };

        enc_kp: encoder_key_press {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tap-ms = <25>;
            display-name = "Encoder Key Press";
        };

    };

    combos {
        compatible = "zmk,combos";

        minus {
            bindings = <&kp MINUS>;
            key-positions = <12 17>; /* D + K */
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <7 8>; /* I + O */
            layers = <0>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <6 7 8>; /* U + I + O */
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>; /* W + E */
            layers = <0>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <6 7>; /* U + I */
            layers = <0>;
        };

        lang1 {
            bindings = <&kp LANG1>;
            key-positions = <17 18>; /* K + L */
            layers = <0>;
        };

        lang2 {
            bindings = <&kp LANG2>;
            key-positions = <11 12>; /* S + D */
            layers = <0>;
        };

        CTL_Z {
            bindings = <&kp LC(Z)>;
            key-positions = <21 22>; /* X + C */
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layout = &LOW_PROFILE_TYPE_B;

        win_default_layer {
            display-name = "BASE";
            bindings = <
                &mt LCMD   Q &kp W       &kp E        &kp R        &kp T                                 &kp Y        &kp U        &kp I       &kp O  &mt RCMD    P
                &lt 2      A &kp S       &kp D        &mt LSHIFT F &kp G                                 &kp H        &mt RSHIFT J &kp K       &kp L  &lt 2       SEMI
                &kp Z        &kp X       &kp C        &lt 1      V &kp B       &lt 2 DEL    &kp BSPC     &kp N        &lt 1      M &kp COMMA   &kp DOT  &mt RALT  SLASH
                                   &kp LCMD  &mt LCTRL TAB  &mt LSHIFT SPACE   &mkp MB1     &mkp  MB2    &mt RSHIFT SPACE  &lt 3 ESC  &kp RALT
            >;
            sensor-bindings =
                <&enc_kp C_VOL_DN C_VOL_UP>,
                <&enc_kp C_VOL_DN C_VOL_UP>;
        };

        layer_1 {
            display-name = "SYMBOLS/NUM";
            bindings = <
                &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                       &kp EQUAL  &kp N7     &kp N8     &kp N9     &kp PLUS
                &kp CARET  &kp AMPS  &kp LPAR  &kp RPAR  &kp SLASH                       &kp N0     &kp N4     &kp N5     &kp N6     &kp MINUS
                &kp TILDE  &kp UNDER &kp BSLH  &kp PIPE  &kp DQT    &kp APOS  &kp SQT    &kp DOT    &kp N1     &kp N2     &kp N3     &kp ASTRK
                                     &kp LCMD  &kp LCTRL &kp LSHIFT &none     &none      &kp none   &none      &kp RALT
            >;
            sensor-bindings =
                <&enc_kp C_VOL_DN C_VOL_UP>,
                <&enc_kp C_VOL_DN C_VOL_UP>;
        };

        layer_2 {
            display-name = "NUM / ARROW";
            bindings = <
                &kp ASTRK        &kp N7     &kp N8     &kp N9     &kp PLUS                        &none  &none     &none   &kp C_VOL_DN &kp C_VOL_UP
                &kp SLASH        &kp N4     &kp N5     &kp N6     &kp MINUS                       &none  &kp LEFT  &kp UP  &kp DOWN     &kp RIGHT
                &kp N0           &kp N1     &kp N2     &kp N3     &kp DOT   &mkp MB4   &mkp MB5   &none  &none     &none   &none        &none
                                        &trans           &trans     &trans     &trans    &trans        &trans  &trans    &trans
            >;
            sensor-bindings =
                <&enc_kp C_VOL_DN C_VOL_UP>,
                <&enc_kp C_VOL_DN C_VOL_UP>;
        };

        layer_3 {
            display-name = "FUNCTION";
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none
                &none   &none   &none   &none   &none   &none   &none   &none   &none   &none    &none  &none
                                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings =
                <&enc_kp C_VOL_DN C_VOL_UP>,
                <&enc_kp C_VOL_DN C_VOL_UP>;
        };

        layer_4 {
			display-name = "SETTING";
			bindings = <
				&studio_bt      &none           &none            &none            &none                        &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
				&none           &none           &none            &none            &none                   &bt BT_CLR     &bt BT_CLR_ALL  &none         &none         &none
				&none           &none           &none            &none            &none                    &none  &none    &bootloader    &none           &none         &none         &none
												                    &trans       &trans  &trans  &trans  &trans  &trans    &trans        &trans
			>;
            sensor-bindings =
                <&enc_kp C_VOL_DN C_VOL_UP>,
                <&enc_kp C_VOL_DN C_VOL_UP>;
        };

        layer_5 {
            status = "reserved";
            display-name = "RESERVE 1";
            bindings = <
                &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                              &none  &none  &none  &none  &none  &none  &none  &none
            >;

            sensor-bindings =
                <&enc_kp C_VOL_DN C_VOL_UP>,
                <&enc_kp C_VOL_DN C_VOL_UP>;
        };

        layer_6 {
            status = "reserved";
            display-name = "RESERVE 2";
            bindings = <
                &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                              &none  &none  &none  &none  &none  &none  &none  &none
            >;

            sensor-bindings =
                <&enc_kp C_VOL_DN C_VOL_UP>,
                <&enc_kp C_VOL_DN C_VOL_UP>;
        };

        layer_7 {
            status = "reserved";
            display-name = "RESERVE 3";
            bindings = <
                &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                              &none  &none  &none  &none  &none  &none  &none  &none
            >;

            sensor-bindings =
                <&enc_kp C_VOL_DN C_VOL_UP>,
                <&enc_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
